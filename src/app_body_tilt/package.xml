<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeversion="3.0"?>
<package format="3">
  <name>app_body_tilt</name>
  <version>0.1.0</version>
  <description>Publishes the rover body's pitch on the drivetrain (body_tilt_joint) from the GQ7's orientation, as a composable node.</description>
  <maintainer email="paulmdavid95@gmail.com">Paul David</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
