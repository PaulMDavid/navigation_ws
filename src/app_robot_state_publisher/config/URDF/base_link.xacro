<?xml version="1.0"?>
<!-- Chassis and drivetrain: chassis_link (the root frame and the body: chassis box and,
     in sensorsuite_front.xacro, every sensor; Nav2, the EKF and li_slam's static TF all
     use it) -> body_tilt_joint -> drivetrain_link -> left/right shafts -> four struts ->
     steering -> wheels.
     The body sits on the shaft axis like on a knife edge and tips (usually back down,
     front up). body_tilt_joint carries that tilt: app_body_tilt publishes the body's
     pitch from the GQ7 on /joint_states, assuming the drivetrain stands level.
     chassis_link's origin is on the shaft pivot axis, midway between the two shafts
     (2026-11-19; the sim model had it 0.114 m higher, 2 cm above the chassis box).
     Other values come from the morpheus_description model in erc-26-simulation.
     The shaft, steering and wheel joints publish TF only once something sends
     /joint_states (issue #15). Don't name a frame base_link: li_slam owns that name
     (odom -> base_link = lidar pose, see app_nav_master/config/odometry/li_slam). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A link drawn with <part>.dae, colliding with <part>.stl. -->
  <xacro:macro name="mesh_link" params="name part vis_xyz vis_rpy col_xyz col_rpy
                                         mass com ixx ixy ixz iyy iyz izz">
    <link name="${name}">
      <visual>
        <origin rpy="${vis_rpy}" xyz="${vis_xyz}"/>
        <geometry>
          <mesh filename="${mesh_dir}/dae/${part}.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="${col_rpy}" xyz="${col_xyz}"/>
        <geometry>
          <mesh filename="${mesh_dir}/stl/${part}.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${com}"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="steer_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="revolute">
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="10.0" lower="${-pi}" upper="${pi}" velocity="10.0"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="continuous">
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="10.0" lower="0.0" upper="0.0" velocity="10.0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <origin rpy="${rpy}" xyz="${xyz}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
    </joint>
  </xacro:macro>

  <!-- ===================== chassis ===================== -->
  <link name="chassis_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.006"/>
      <geometry>
        <box size="0.7 0.42 0.2"/>
      </geometry>
      <material name="">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.006"/>
      <geometry>
        <box size="0.7 0.42 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0037041613 0.0428197174 0.0033278873"/>
      <mass value="27.0"/>
      <inertia ixx="0.6797017835" ixy="-0.0079907052" ixz="0.0127828566" iyy="1.2877765418" iyz="0.0117679376" izz="1.6878998816"/>
    </inertial>
  </link>

  <!-- ===================== body tilt ===================== -->
  <!-- drivetrain_link: on the shaft axis, level when the body is level. The joint value
       is the body's pitch (ROS convention: positive = nose down), so with the axis
       along -y the drivetrain is turned back by that pitch and stays level. -->
  <link name="drivetrain_link"/>
  <joint name="body_tilt_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="chassis_link"/>
    <child link="drivetrain_link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="0" lower="${-pi/2}" upper="${pi/2}" velocity="10.0"/>
  </joint>

  <!-- ===================== left side ===================== -->
  <xacro:mesh_link name="shaft_left_link" part="shaft"
    vis_xyz="-0.1 0.0 -0.231" vis_rpy="-1.5707963267948966 -1.5707963267948966 0.0"
    col_xyz="-0.1 0.0 -0.231014" col_rpy="-1.571 -1.5707999999991324 0.0"
    mass="0.75" com="-0.0002091194 1.32101e-05 0.0184469812"
    ixx="0.0012178097" ixy="-5.6e-09" ixz="2.83456e-05" iyy="0.0008777415" iyz="1.4e-09" izz="0.0004882588"/>
  <xacro:steer_joint name="shaft_left_joint" parent="drivetrain_link" child="shaft_left_link"
    xyz="0.0 0.235014 0.001" rpy="1.5707999999991324 -1.5707900000007928 -3.1415899999999253"/>

  <!-- front left -->
  <xacro:mesh_link name="strut_fl_link" part="strut"
    vis_xyz="-0.095 -0.03 -0.321" vis_rpy="-1.5707963267948966 -1.5707963267948966 0.0"
    col_xyz="-0.0947906 -0.0295442 -0.320703" col_rpy="-1.571 -1.5707999999991324 0.0"
    mass="0.6" com="-0.0739820888 0.4431306277 -0.0142543342"
    ixx="0.0120960241" ixy="0.0019557104" ixz="-1.01651e-05" iyy="0.0007162043" iyz="5.93325e-05" izz="0.0122581859"/>
  <xacro:fixed_joint name="strut_fl_joint" parent="shaft_left_link" child="strut_fl_link"
    xyz="-0.00520945 0.0295442 0.0899929" rpy="0.0 0.0 0.0"/>

  <xacro:mesh_link name="steering_fl_link" part="steering"
    vis_xyz="-0.308 0.536 0.017" vis_rpy="1.5707963267948966 0.0012042771838760874 0.0"
    col_xyz="-0.308035 0.536061 0.0167576" col_rpy="1.571 0.0012006700002099185 0.0"
    mass="1.6" com="0.0004367622 0.0434819885 -0.1159842788"
    ixx="0.0052279077" ixy="1.8091e-06" ixz="1.3286e-05" iyy="0.0053004683" iyz="0.0005027067" izz="0.0014735517"/>
  <xacro:steer_joint name="steering_fl_joint" parent="strut_fl_link" child="steering_fl_link"
    xyz="-0.111216 0.504597 -0.0155261" rpy="-1.5695999999994064 -0.0015880299992990737 -1.5707999999991324"/>

  <xacro:mesh_link name="wheel_fl_link" part="wheel"
    vis_xyz="0.0 0.0 -0.04" vis_rpy="0.0 0.0 0.0"
    col_xyz="0.0 0.0 -0.04" col_rpy="0.0 0.0 0.0"
    mass="1.4" com="0.0 -0.0002387564 -0.04"
    ixx="0.0062960167" ixy="0.0" ixz="-1.7e-09" iyy="0.0062960234" iyz="0.0" izz="0.0111555186"/>
  <xacro:wheel_joint name="wheel_fl_joint" parent="steering_fl_link" child="wheel_fl_link"
    xyz="0.000859913 -0.0328387 -0.152" rpy="1.5707999999991324 0.002023000000786 -0.026182653588951874"/>

  <!-- rear left -->
  <xacro:mesh_link name="strut_rl_link" part="strut"
    vis_xyz="-0.095 -0.03 -0.295" vis_rpy="-1.5707963267948966 -1.5707963267948966 0.0"
    col_xyz="-0.0947906 -0.0295442 -0.295326" col_rpy="-1.571 -1.5707999999991324 0.0"
    mass="0.6" com="-0.0756316965 0.4736684486 0.0110207527"
    ixx="0.0120903014" ixy="0.0019549161" ixz="-1.01621e-05" iyy="0.000716067" iyz="5.92839e-05" izz="0.0122522986"/>
  <xacro:fixed_joint name="strut_rl_joint" parent="shaft_left_link" child="strut_rl_link"
    xyz="-0.00520945 -0.0295443 0.0899929" rpy="3.1415899999999253 0.0 0.0"/>

  <xacro:mesh_link name="steering_rl_link" part="steering"
    vis_xyz="-0.308 0.536 0.017" vis_rpy="1.5707963267948966 0.0012042771838760874 0.0"
    col_xyz="-0.308035 0.536061 0.0167576" col_rpy="1.571 0.0012006700002099185 0.0"
    mass="1.6" com="0.0004367622 0.0434819885 -0.1159842788"
    ixx="0.0052279077" ixy="1.8091e-06" ixz="1.3286e-05" iyy="0.0053004683" iyz="0.0005027067" izz="0.0014735517"/>
  <xacro:steer_joint name="steering_rl_joint" parent="strut_rl_link" child="steering_rl_link"
    xyz="-0.111216 0.504597 0.00985065" rpy="1.5695999999994064 0.0015880299992990737 1.5707900000007928"/>

  <xacro:mesh_link name="wheel_rl_link" part="wheel"
    vis_xyz="0.0 0.0 0.04" vis_rpy="0.0 0.0 0.0"
    col_xyz="0.0 0.0 0.04" col_rpy="0.0 0.0 0.0"
    mass="1.4" com="0.0 -0.0002387564 0.04"
    ixx="0.0062960167" ixy="0.0" ixz="-1.7e-09" iyy="0.0062960234" iyz="0.0" izz="0.0111555186"/>
  <xacro:wheel_joint name="wheel_rl_joint" parent="steering_rl_link" child="wheel_rl_link"
    xyz="0.000859913 0.0328387 -0.152" rpy="-1.5707999999991324 0.0020191899993887734 3.1154100000008413"/>

  <!-- ===================== right side ===================== -->
  <xacro:mesh_link name="shaft_right_link" part="shaft"
    vis_xyz="0.0 0.1 0.231" vis_rpy="-3.141592653589793 1.5707963267948966 0.0"
    col_xyz="0.0 0.1 0.231014" col_rpy="-3.142 1.5707999999991324 0.0"
    mass="0.75" com="-1.32101e-05 0.0002091194 -0.0184469812"
    ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
  <joint name="shaft_right_joint" type="revolute">
    <origin rpy="-1.5707999999991324 0.0 0.0" xyz="8.1925e-05 -0.231256 -0.001299"/>
    <parent link="drivetrain_link"/>
    <child link="shaft_right_link"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit effort="10.0" lower="${-pi}" upper="${pi}" velocity="10.0"/>
    <dynamics damping="0.7" friction="0.0"/>
    <mimic joint="shaft_left_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <!-- front right -->
  <xacro:mesh_link name="strut_fr_link" part="strut"
    vis_xyz="-0.095 -0.03 -0.295" vis_rpy="-1.5707963267948966 -1.5707963267948966 0.0"
    col_xyz="-0.0947906 -0.0295442 -0.295326" col_rpy="-1.571 -1.5707999999991324 0.0"
    mass="0.6" com="-0.0739820888 0.4431306277 0.0117456658"
    ixx="0.0120960241" ixy="0.0019557104" ixz="-1.01651e-05" iyy="0.0007162043" iyz="5.93325e-05" izz="0.0122581859"/>
  <xacro:fixed_joint name="strut_fr_joint" parent="shaft_right_link" child="strut_fr_link"
    xyz="0.0295443 0.00520945 -0.0899929" rpy="0.0 0.0 -1.5707999999991324"/>

  <xacro:mesh_link name="steering_fr_link" part="steering"
    vis_xyz="-0.308 0.536 0.017" vis_rpy="1.5707963267948966 0.0012042771838760874 0.0"
    col_xyz="-0.308035 0.536061 0.0167576" col_rpy="1.571 0.0012006700002099185 0.0"
    mass="1.6" com="0.0004367622 0.0434819885 -0.1159842788"
    ixx="0.0052279077" ixy="1.8091e-06" ixz="1.3286e-05" iyy="0.0053004683" iyz="0.0005027067" izz="0.0014735517"/>
  <xacro:steer_joint name="steering_fr_joint" parent="strut_fr_link" child="steering_fr_link"
    xyz="-0.111216 0.504597 0.00985065" rpy="-1.5695899999993215 3.141592653589793 -1.5707600000005377"/>

  <xacro:mesh_link name="wheel_fr_link" part="wheel"
    vis_xyz="0.0 0.0 -0.04" vis_rpy="0.0 0.0 0.0"
    col_xyz="0.0 0.0 -0.04" col_rpy="0.0 0.0 0.0"
    mass="1.4" com="0.0 -0.0002387564 -0.04"
    ixx="0.0062960167" ixy="0.0" ixz="-1.7e-09" iyy="0.0062960234" iyz="0.0" izz="0.0111555186"/>
  <xacro:wheel_joint name="wheel_fr_joint" parent="steering_fr_link" child="wheel_fr_link"
    xyz="0.000859913 0.0328387 -0.152" rpy="-1.5707999999991324 0.00442516999951294 -0.026179900000444293"/>

  <!-- rear right -->
  <xacro:mesh_link name="strut_rr_link" part="strut"
    vis_xyz="-0.095 -0.03 -0.321" vis_rpy="-1.5707963267948966 -1.5707963267948966 0.0"
    col_xyz="-0.0947906 -0.0295442 -0.320703" col_rpy="-1.571 -1.5707999999991324 0.0"
    mass="0.6" com="-0.0756316965 0.4736684486 -0.0149792473"
    ixx="0.0120903014" ixy="0.0019549161" ixz="-1.01621e-05" iyy="0.000716067" iyz="5.92839e-05" izz="0.0122522986"/>
  <xacro:fixed_joint name="strut_rr_joint" parent="shaft_right_link" child="strut_rr_link"
    xyz="-0.0295442 0.00520945 -0.0899929" rpy="-3.1415899999999253 0.0 -1.5707999999991324"/>

  <xacro:mesh_link name="steering_rr_link" part="steering"
    vis_xyz="-0.308 0.536 0.017" vis_rpy="1.5707963267948966 0.0012042771838760874 0.0"
    col_xyz="-0.308035 0.536061 0.0167576" col_rpy="1.571 0.0012006700002099185 0.0"
    mass="1.6" com="0.0008678457 0.0453345829 -0.1283715226"
    ixx="0.0052284237" ixy="1.7963e-06" ixz="1.34245e-05" iyy="0.0053013768" iyz="0.0005026464" izz="0.0014739211"/>
  <xacro:steer_joint name="steering_rr_joint" parent="strut_rr_link" child="steering_rr_link"
    xyz="-0.111216 0.504597 -0.0155261" rpy="1.5695899999993215 3.107946953589153 1.5708399999994722"/>

  <xacro:mesh_link name="wheel_rr_link" part="wheel"
    vis_xyz="0.0 0.0 -0.04" vis_rpy="0.0 0.0 0.0"
    col_xyz="0.0 0.0 -0.04" col_rpy="0.0 0.0 0.0"
    mass="1.4" com="0.0001576409 -0.0006915734 -0.0400513418"
    ixx="0.0063063969" ixy="6.7586e-06" ixz="2.6546e-06" iyy="0.0062998989" iyz="-2.919e-06" izz="0.0111226164"/>
  <xacro:wheel_joint name="wheel_rr_joint" parent="steering_rr_link" child="wheel_rr_link"
    xyz="0.000859913 0.0328387 -0.152" rpy="-1.5707999999991324 0.004421350000869758 -0.026179900000444293"/>

</robot>
