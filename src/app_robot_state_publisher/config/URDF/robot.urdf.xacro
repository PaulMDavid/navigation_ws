<?xml version="1.0"?>
<!-- Morpheus rover, navigation model (from erc-26-simulation's morpheus_description). -->
<robot name="morpheus_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_dir" value="package://morpheus_description/urdf/01_robot_description/meshes"/>

  <xacro:include filename="base_link.xacro"/>
  <xacro:include filename="sensorsuite_front.xacro"/>
</robot>
