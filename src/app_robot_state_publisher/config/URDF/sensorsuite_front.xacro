<?xml version="1.0"?>
<!-- Front sensor suite: Ouster OS0 lidar, ZED2i stereo camera, IMU. All mounted on
     chassis_link. Mount offsets are the properties below (placeholders from the sim
     model until measured on the rover).
     If you change the lidar mount, also update the inverse in
     app_nav_master/config/odometry/li_slam/lio_base_to_chassis.yaml. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- chassis_link -> mount link, metres / radians.
       Lidar: base 1 cm above the body top (z 0.094 = box top, + 0.01 for the 3D-printed
       spacer it sits on), flush inside the front-right
       corner (box x 0.35 / y -0.21 minus the OS0 mesh's +x 0.0402 / -y 0.0434 extent).
       ZED2i: centred in y, camera_center 4 cm ahead of the body's top front edge
       (x 0.35 + 0.04), camera top level with the body top: 0.094 - 0.015 (camera_link
       -> camera_center) - 0.0153 (mesh top above camera_center) = 0.0637. -->
  <xacro:property name="lidar_xyz" value="0.3098 -0.1666 0.104"/>
  <xacro:property name="lidar_rpy" value="0.0 0.0 0.0"/>
  <xacro:property name="zed2i_xyz" value="0.39 0.0 0.0637"/>
  <xacro:property name="zed2i_rpy" value="0.0 0.0 0.0"/>
  <xacro:property name="imu_xyz"   value="0.15 0.0 0.10"/>
  <xacro:property name="imu_rpy"   value="0 0 0"/>

  <!-- TODO (2026-11-19):
       - IMU: imu_xyz / imu_rpy are still the sim placeholder. Measure the real IMU
         mount (the GQ7, /imu/data) and update them.
       - GNSS antennas: add links for the GQ7's two antennas here (e.g. gnss_1_link,
         gnss_2_link) with their measured mounts. Then:
         - replace the placeholder static TF chassis_link -> gnss_link
           (app_nav_master/config/robot/gnss_tf.yaml, z 0.5);
         - set the lever arms in app_microstrain/config/gq7.yml
           (gnss1/gnss2_antenna_offset, now [0, -0.5, 0] / [0, 0.5, 0]) to the same
           values. Mind the frames: GQ7 is x fwd, y right, z down; URDF is x fwd,
           y left, z up. -->

  <!-- ===================== IMU ===================== -->
  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
    <parent link="chassis_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ===================== Ouster OS0 ===================== -->
  <link name="os0_lidar_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="${mesh_dir}/dae/os0_lidar.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.5 0.5 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0178636494 -0.0004425342 0.0269007094"/>
      <mass value="0.4"/>
      <inertia ixx="0.0003556192" ixy="-3.2e-09" ixz="-3.3913e-06" iyy="0.0003538593" iyz="-8.6e-09" izz="0.0003519074"/>
    </inertial>
  </link>
  <joint name="os0_lidar_joint" type="fixed">
    <origin rpy="${lidar_rpy}" xyz="${lidar_xyz}"/>
    <parent link="chassis_link"/>
    <child link="os0_lidar_link"/>
  </joint>

  <!-- os_sensor is the Ouster driver's frame; the driver adds os_lidar / os_imu below it -->
  <link name="os_sensor"/>
  <joint name="os_sensor_bridge_joint" type="fixed">
    <parent link="os0_lidar_link"/>
    <child link="os_sensor"/>
  </joint>

  <!-- ===================== ZED2i ===================== -->
  <!-- mount frame = bottom centre of the camera (same place as zed2i_camera_link) -->
  <link name="zed_2i_link"/>
  <joint name="zed_2i_joint" type="fixed">
    <origin rpy="${zed2i_rpy}" xyz="${zed2i_xyz}"/>
    <parent link="chassis_link"/>
    <child link="zed_2i_link"/>
  </joint>

  <!-- ZED wrapper frames (the wrapper runs with publish_urdf/publish_tf false) -->
  <link name="zed2i_camera_link"/>
  <joint name="zed_camera_bridge_joint" type="fixed">
    <parent link="zed_2i_link"/>
    <child link="zed2i_camera_link"/>
  </joint>

  <!-- Stereolabs' zed2i mesh, drawn on camera_center as in zed_macro.urdf.xacro -->
  <link name="zed2i_camera_center">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/stl/zed2i_stereolabs.stl"/>
      </geometry>
      <material name="zed2i_grey">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/stl/zed2i_stereolabs.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="zed2i_camera_center_joint" type="fixed">
    <parent link="zed2i_camera_link"/>
    <child link="zed2i_camera_center"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

  <link name="zed2i_left_camera_frame"/>
  <joint name="zed2i_left_camera_joint" type="fixed">
    <parent link="zed2i_camera_center"/>
    <child link="zed2i_left_camera_frame"/>
    <origin xyz="-0.01 0.06 0" rpy="0 0 0"/>
  </joint>

  <link name="zed2i_left_camera_frame_optical"/>
  <joint name="zed2i_left_camera_optical_joint" type="fixed">
    <parent link="zed2i_left_camera_frame"/>
    <child link="zed2i_left_camera_frame_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="zed2i_right_camera_frame"/>
  <joint name="zed2i_right_camera_joint" type="fixed">
    <parent link="zed2i_camera_center"/>
    <child link="zed2i_right_camera_frame"/>
    <origin xyz="-0.01 -0.06 0" rpy="0 0 0"/>
  </joint>

  <link name="zed2i_right_camera_frame_optical"/>
  <joint name="zed2i_right_camera_optical_joint" type="fixed">
    <parent link="zed2i_right_camera_frame"/>
    <child link="zed2i_right_camera_frame_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
