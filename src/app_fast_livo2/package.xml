<?xml version="1.0"?>
<package format="3">
  <name>app_fast_livo2</name>
  <version>0.0.1</version>
  <description>Composable-node launch tying ZED2i + Ouster + FAST-LIVO2 into one container</description>
  <maintainer email="p.david@campus.tu-berlin.de">Paul Mangalam</maintainer>
  <license>MIT</license>

  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>ouster_ros</exec_depend>
  <exec_depend>fast_livo</exec_depend>
  <exec_depend>demo_nodes_cpp</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
