# SAPOS Berlin HEPS (NTRIP) login for this robot. Lives at /etc/navws/sapos.env on the
# robot (scripts/robot_setup/apply.sh creates it, mode 0600), never in the repo.
# One login per robot: each allows only one connection at a time.
#   orintwo: saposbe1179-1   rover: saposbe1179-2
SAPOS_USER=
SAPOS_PASSWORD=
SAPOS_HOST=www.sapos-be-ntrip.de
SAPOS_PORT=2101
SAPOS_MOUNTPOINT=VRS_3_4G_BE
